---
import { profile } from '../../content/profile';
import BaseLayout from '../../layouts/BaseLayout.astro';
import en from '../../content/en';
import pl from '../../content/pl';
import uk from '../../content/uk';
import { languages, type Language } from '../../content/types';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const language = Astro.params.lang as Language;
const content = { en, pl, uk }[language];
---
<BaseLayout language={language} content={content}>
  <section class="introduction" aria-labelledby="name">
    <p class="eyebrow">{content.introductionLabel}</p>
    <h1 id="name">{profile.name}</h1>
    <p class="role">{profile.currentRole}<br /><span>{profile.employer}</span></p>
    <div class="biography">
      <p>{content.introduction}</p>

    </div>
    <a class="profile-link" href={profile.github}>{content.githubLabel}<span aria-hidden="true"> ↗</span></a>
  </section>
</BaseLayout>
