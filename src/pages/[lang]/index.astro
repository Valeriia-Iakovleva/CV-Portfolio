---
import BaseLayout from '../../layouts/BaseLayout.astro';
import en from '../../content/en';
import pl from '../../content/pl';
import uk from '../../content/uk';
import { languages, type Language } from '../../content/types';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const language = Astro.params.lang as Language;
const content = { en, pl, uk }[language];
---
<BaseLayout language={language} content={content}>
  <section class="introduction" aria-labelledby="name">
    <h1 id="name">{content.name}</h1>
    <p class="role">{content.currentRole}<br /><span>{content.employer}</span></p>
    <div class="biography">
      <p>{content.introduction}</p>
      <p>{content.direction}</p>
    </div>
  </section>
</BaseLayout>
