---
import Arrow from '../../components/Arrow.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile, projectFacts, skillTools } from '../../content/profile';
import en from '../../content/en';
import pl from '../../content/pl';
import uk from '../../content/uk';
import { languages, type Language, type SkillId } from '../../content/types';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const language = Astro.params.lang as Language;
const content = { en, pl, uk }[language];
const skillIds = Object.keys(skillTools) as SkillId[];
const projectGroups = ['completed', 'in-progress'] as const;
---
<BaseLayout language={language} content={content}>
  <section class="introduction" aria-labelledby="name">
    <div class="hero-copy">
      <p class="eyebrow overline"><span aria-hidden="true"></span>{content.introductionLabel}</p>
      <h1 id="name">{profile.name}<span class="name-dot" aria-hidden="true">.</span></h1>
      <p class="role">
        {profile.currentRole}
        <span>{profile.employer} <span aria-hidden="true">·</span> {content.location}</span>
      </p>
      <p class="intro-text">{content.introduction}</p>
      <div class="hero-actions">
        <a class="button" href="#projects">{content.ui.explore}<Arrow /></a>
        <a class="text-link" href="#experience">{content.ui.readCV}<span aria-hidden="true"> ↓</span></a>
      </div>
    </div>
    <aside class="focus-note">
      <p class="eyebrow">{content.focusTitle}</p>
      <h2>{content.headline}</h2>
      <p>{content.focus}</p>
      <a href={profile.github}>{content.githubLabel}<Arrow /></a>
    </aside>
  </section>

  <section id="experience" class="cv-section" aria-labelledby="experience-heading">
    <SectionHeading id="experience-heading" number="01"
      title={content.ui.experienceTitle} description={content.ui.experienceIntro} />
    <ExperienceList language={language} content={content} />
  </section>

  <section id="projects" class="cv-section projects-section" aria-labelledby="projects-heading">
    <SectionHeading id="projects-heading" number="02"
      title={content.ui.projectsTitle} description={content.ui.projectsIntro} />
    {projectGroups.map(status => <>
      <h3 class:list={['project-group-title', { 'in-progress-heading': status === 'in-progress' }]}>
        {status === 'completed' ? content.ui.completedGroup : content.ui.inProgressGroup}
      </h3>
      {status === 'in-progress' && content.ui.statusNote && <p class="status-note">{content.ui.statusNote}</p>}
      {projectFacts.filter(project => project.status === status).map(facts => (
        <ProjectEntry facts={facts} content={content} />
      ))}
    </>)}
  </section>

  <section id="about" class="cv-section" aria-labelledby="about-heading">
    <SectionHeading id="about-heading" number="03" title={content.ui.aboutTitle} />
    <div class="about-layout">
      <div class="about-copy">{content.about.map(paragraph => <p>{paragraph}</p>)}</div>
      <div class="education">
        <h3 class="eyebrow">{content.ui.educationTitle}</h3>
        <h4>{content.education.degree}</h4>
        <p>{profile.degreeInstitution}</p>
        <p class="date">{profile.degreeStart} — {profile.degreeEnd}</p>
        <p class="education-track">{content.education.track}</p>
        <p class="education-topics">{content.education.topics}</p>
      </div>
    </div>
    <div class="skills-block">
      <h3 class="subheading">{content.ui.skillsTitle}</h3>
      <div class="skills-grid">
        {skillIds.map(id => <article>
          <h4>{content.skills[id].title}</h4>
          <p>{content.skills[id].description}</p>
          {skillTools[id].length > 0 && <ul class="tags">{skillTools[id].map(tool => <li>{tool}</li>)}</ul>}
        </article>)}
      </div>
    </div>
    <div class="languages-block">
      <h3 class="subheading">{content.ui.languagesTitle}</h3>
      <dl>{Object.values(content.spokenLanguages).map(item => <div>
        <dt>{item.name}</dt><dd>{item.level}</dd>
      </div>)}</dl>
    </div>
  </section>

  <section id="contact" class="cv-section contact-section" aria-labelledby="contact-heading">
    <SectionHeading id="contact-heading" number="04"
      title={content.ui.contactTitle} description={content.ui.contactText} />
    <div class="contact-actions"><a href={profile.github}>{content.githubLabel}<Arrow /></a></div>
    <button type="button" class="print-button" data-print hidden>{content.ui.print}<Arrow /></button>
  </section>
</BaseLayout>
