---
interface Props { number: string; title: string; id?: string; description?: string; }
const { number, title, description, id } = Astro.props;
---
<div class="section-heading">
  <span class="section-number" aria-hidden="true">{number}</span>
  <div><h2 id={id}>{title}</h2>{description && <p>{description}</p>}</div>
</div>
